# Flask Configuration
SECRET_KEY=your-secret-key-here
FLASK_ENV=development

# MySQL Database Configuration
MYSQL_HOST=localhost
MYSQL_USER=root
MYSQL_PASSWORD=your-password-here
MYSQL_DB=application_portal

# Discord Bot Configuration (Required for Auto-Role Assignment)
# Get bot token from: https://discord.com/developers/applications
DISCORD_BOT_TOKEN=your-discord-bot-token-here

# Get guild ID by right-clicking your server icon (Developer Mode must be enabled)
DISCORD_GUILD_ID=your-discord-guild-id-here
